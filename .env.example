# Server
PORT=3000
NODE_ENV=development

# Security - set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins, or * to allow all
CORS_ORIGINS=http://localhost:4200,https://chat-app-frontend-12bbe.web.app,https://chat-app-frontend-12bbe.firebaseapp.com

# Where the JSON data files are stored
DATA_DIR=./data

# Optional: URL to ping every 10 minutes to keep a free-tier instance awake
KEEP_ALIVE_URL=
